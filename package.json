{
  "name": "users-service",
  "version": "1.0.0",
  "description": "Authentication service providing user identity management, authentication, and authorization",
  "type": "module",
  "author": "Ali Madooei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proj-courseware/users-service.git"
  },
  "homepage": "https://proj-courseware.github.io/users-service/",
  "bugs": {
    "url": "https://github.com/proj-courseware/users-service/issues"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "validate": "pnpm type-check && pnpm lint:fix && pnpm format:fix && pnpm test",
    "clean": "rm -rf dist coverage",
    "clean:all": "rm -rf dist coverage node_modules",
    "mock-frontend": "tsx scripts/mock-frontend.ts",
    "docker:dev": "docker compose --project-name users-service --env-file docker/.env -f docker/docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose --project-name users-service -f docker/docker-compose.dev.yml down",
    "docker:prod": "docker compose --project-name users-service --env-file docker/.env.production -f docker/docker-compose.prod.yml up --build",
    "docker:prod:down": "docker compose --project-name users-service -f docker/docker-compose.prod.yml down"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.2",
    "argon2": "^0.43.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "nodemailer": "^7.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.1.0",
    "jiti": "^2.4.2",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
